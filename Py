import mysql.connector
from mysql.connector.conversion import MySQLConverter
from decimal import Decimal

# ======================================
# CONVERSOR AUTOMÁTICO DECIMAL → FLOAT
# ======================================

class FloatConverter(MySQLConverter):
    def _float(self, value, dsc=None):
        return float(value)

    def _decimal(self, value, dsc=None):
        return float(value)


# ======================================
# CONEXÃO COM O BANCO DE DADOS
# ======================================

def conectar():
    conn = mysql.connector.connect(
        host="localhost",
        user="root",
        password="790126",
        database="gymmm"
    )
    conn.converter_class = FloatConverter
    return conn


# ======================================
# CADASTRAR ALUNO
# ======================================

def cadastrar_aluno():
    print("\n--- CADASTRAR ALUNO ---")
    nome = input("Nome: ")
    peso = float(input("Peso (kg): "))
    altura = float(input("Altura (m): "))
    treino = int(input("ID do treino: "))
    plano = int(input("ID do plano: "))

    con = conectar()
    cursor = con.cursor()

    sql = """
    INSERT INTO tbl_aluno (nome_aluno, peso_aluno, altura_aluno, fk_alu_tre, fk_alu_plano)
    VALUES (%s, %s, %s, %s, %s)
    """
    cursor.execute(sql, (nome, peso, altura, treino, plano))
    con.commit()
    con.close()

    print("\nAluno cadastrado com sucesso!\n")


# ======================================
# LISTAR ALUNOS (Simples)
# ======================================

def listar_alunos():
    con = conectar()
    cursor = con.cursor()

    cursor.execute("SELECT id_aluno, nome_aluno, peso_aluno, altura_aluno FROM tbl_aluno")

    print("\nID | Nome | Peso | Altura")
    print("------------------------------")

    for id_aluno, nome, peso, altura in cursor.fetchall():
        print(f"{id_aluno} | {nome} | {peso:.2f} kg | {altura:.2f} m")

    con.close()
    print()


# ======================================
# LISTAR ALUNO + TREINO
# ======================================

def listar_aluno_treino():
    con = conectar()
    cursor = con.cursor()

    sql = """
    SELECT a.nome_aluno, a.peso_aluno, a.altura_aluno, t.nome_treino
    FROM tbl_aluno a
    INNER JOIN tbl_treinos t ON a.fk_alu_tre = t.id_treino
    """

    cursor.execute(sql)

    print("\nNome | Peso | Altura | Treino")
    print("----------------------------------")

    for nome, peso, altura, treino in cursor.fetchall():
        print(f"{nome} | {peso:.2f} kg | {altura:.2f} m | {treino}")

    con.close()
    print()


# ======================================
# LISTAR COMPLETO: ALUNO + TREINO + PLANO + PREÇO

# ======================================

def listar_completo():
    con = conectar()
    cursor = con.cursor()

    sql = """
    SELECT a.nome_aluno,
           a.peso_aluno,
           a.altura_aluno,
           t.nome_treino,
           p.nome_plano,
           pr.valor_plano
    FROM tbl_aluno a
    INNER JOIN tbl_treinos t ON a.fk_alu_tre = t.id_treino
    INNER JOIN tbl_planos p ON a.fk_alu_plano = p.id_plano
    INNER JOIN tbl_precos pr ON pr.fk_prec_plan = p.id_plano
    """

    cursor.execute(sql)

    print("\nNome | Peso | Altura | Treino | Plano | Preço")
    print("-----------------------------------------------------------")

    for nome, peso, altura, treino, plano, preco in cursor.fetchall():
        print(f"{nome} | {peso:.2f} kg | {altura:.2f} m | {treino} | {plano} | R${preco:.2f}")

    con.close()
    print()


